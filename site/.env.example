# Promptbook: local settings. Copy to .env; every line is optional.

# Where your own prompts (My Library) are kept, one markdown file each.
# Relative paths resolve against site/. Point it at a synced or git-tracked
# folder to back it up. Default: site/my-library (gitignored).
# MY_LIBRARY_DIR=my-library

# Address the server listens on. The default, 127.0.0.1, keeps it to this
# machine: there are no accounts, so anyone who can reach it can edit My Library.
# HOST=127.0.0.1

# true = serve the Public Library only, with every write route refused.
# The hosted demo gets this automatically from Vercel's VERCEL variable.
# READ_ONLY=false

# Folders the MCP server's `file` argument may read from, so an agent can save a
# local .md file (a long SKILL.md, say) to My Library without retyping it.
# Separate several with ; on Windows, : elsewhere. Unset = file import refused.
# IMPORT_ROOTS=D:/repos/my-org

# Extra hostnames the server answers to (pages and API, dev and npm start),
# comma-separated; a leading dot allows subdomains. Needed when a proxy forwards
# another Host, e.g. `tailscale serve`: my-pc,my-pc.tailnet-name.ts.net
# ALLOWED_HOSTS=
