# My Prompt Library: local settings. Copy to .env; every line is optional.

# Where your own prompts (My Library) are kept, one markdown file each.
# Relative paths resolve against site/. Point it at a synced or git-tracked
# folder to back it up. Default: site/my-library (gitignored).
# MY_LIBRARY_DIR=my-library

# Address the server listens on. The default, 127.0.0.1, keeps it to this
# machine: there are no accounts, so anyone who can reach it can edit My Library.
# HOST=127.0.0.1

# true = serve the Public Library only, with every write route refused.
# The hosted demo gets this automatically from Vercel's VERCEL variable.
# READ_ONLY=false
