{
  "name": "promptbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:index && tsc && vite build",
    "build:index": "node scripts/build-prompt-index.js",
    "start": "npm run build && tsx server.ts --production",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "vercel-build": "npm run build:index && tsc && vite build",
    "test:routes": "tsx scripts/api-routes.test.mjs",
    "test:my-library": "tsx scripts/my-library.test.mjs",
    "test:read-only": "tsx scripts/read-only.test.mjs",
    "test:prompt-content": "tsx scripts/prompt-content.test.mjs",
    "test:markdown-file": "tsx scripts/markdown-file.test.mjs",
    "mcp": "tsx mcp/server.ts",
    "test:mcp": "tsx scripts/mcp-server.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4"
  }
